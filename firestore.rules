rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados pessoais: o próprio usuário ou o admin
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'gustavorenanpetry@gmail.com'
      );
    }

    // Solicitações de acesso
    match /accessRequests/{userId} {
      // Qualquer usuário autenticado pode criar/ler a própria solicitação
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read:   if request.auth != null && request.auth.uid == userId;
      // Admin pode ler e atualizar todas as solicitações
      allow read, write: if request.auth != null && request.auth.token.email == 'gustavorenanpetry@gmail.com';
    }
  }
}
